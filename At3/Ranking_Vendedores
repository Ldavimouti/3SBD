WITH VENDAS_MENSAIS AS (
    SELECT
        V.ID_VENDEDOR,
        TRUNC(V.DT_VENDA, 'MM') AS MES,
        SUM(V.VALOR_LIQUIDO) AS TOTAL_VENDIDO
    FROM TB_VENDA V
    WHERE V.STATUS = 'FECHADA'
    GROUP BY
        V.ID_VENDEDOR,
        TRUNC(V.DT_VENDA, 'MM')
)
SELECT
    VD.NOME AS VENDEDOR,
    TO_CHAR(VM.MES, 'MM/YYYY') AS MES,
    VM.TOTAL_VENDIDO,
    DENSE_RANK() OVER (
        PARTITION BY VM.MES
        ORDER BY VM.TOTAL_VENDIDO DESC
    ) AS POSICAO_RANKING
FROM VENDAS_MENSAIS VM
JOIN TB_VENDEDOR VD
    ON VD.ID_VENDEDOR = VM.ID_VENDEDOR
ORDER BY
    VM.MES,
    POSICAO_RANKING,
    VD.NOME;
