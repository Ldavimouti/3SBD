WITH FATURAMENTO_VENDEDOR AS (
    SELECT
        VD.ID_VENDEDOR,
        VD.NOME AS VENDEDOR,
        SUM(V.VALOR_LIQUIDO) AS FATURAMENTO
    FROM TB_VENDA V
    JOIN TB_VENDEDOR VD
        ON VD.ID_VENDEDOR = V.ID_VENDEDOR
    WHERE V.STATUS = 'FECHADA'
    GROUP BY
        VD.ID_VENDEDOR,
        VD.NOME
)
SELECT
    VENDEDOR,
    FATURAMENTO,
    ROUND(
        FATURAMENTO /
        SUM(FATURAMENTO) OVER () * 100,
        2
    ) AS PERCENTUAL_FATURAMENTO
FROM FATURAMENTO_VENDEDOR
ORDER BY FATURAMENTO DESC;
