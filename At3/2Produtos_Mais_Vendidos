WITH PRODUTOS_VENDIDOS AS (
    SELECT
        C.ID_CATEGORIA,
        C.NOME AS CATEGORIA,
        P.ID_PRODUTO,
        P.NOME AS PRODUTO,
        SUM(VI.QUANTIDADE) AS QUANTIDADE_TOTAL
    FROM TB_VENDA_ITEM VI
    JOIN TB_VENDA V
        ON V.ID_VENDA = VI.ID_VENDA
    JOIN TB_PRODUTO P
        ON P.ID_PRODUTO = VI.ID_PRODUTO
    JOIN TB_CATEGORIA C
        ON C.ID_CATEGORIA = P.ID_CATEGORIA
    WHERE V.STATUS = 'FECHADA'
    GROUP BY
        C.ID_CATEGORIA,
        C.NOME,
        P.ID_PRODUTO,
        P.NOME
),
RANKING_PRODUTOS AS (
    SELECT
        CATEGORIA,
        PRODUTO,
        QUANTIDADE_TOTAL,
        DENSE_RANK() OVER (
            PARTITION BY ID_CATEGORIA
            ORDER BY QUANTIDADE_TOTAL DESC
        ) AS POSICAO_RANKING
    FROM PRODUTOS_VENDIDOS
)
SELECT
    CATEGORIA,
    PRODUTO,
    QUANTIDADE_TOTAL,
    POSICAO_RANKING
FROM RANKING_PRODUTOS
WHERE POSICAO_RANKING <= 2
ORDER BY
    CATEGORIA,
    POSICAO_RANKING,
    PRODUTO;
